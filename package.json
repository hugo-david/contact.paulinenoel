{
  "name": "contact.paulinenoel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "node ace test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@biomejs/biome": "^2.5.8",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.4",
    "@types/node": "~26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "storybook": "^10.5.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.4.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^5.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.0",
    "@base-ui/react": "^1.7.0",
    "@inertiajs/core": "^3.6.1",
    "@inertiajs/react": "^3.7.0",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "edge.js": "^6.5.1",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "esbuild",
      "fsevents"
    ]
  }
}
